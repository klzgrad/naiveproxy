import("../../../gn/perfetto.gni")
import("../../../gn/proto_library.gni")
import("../../../gn/protozero_descriptor_diff.gni")

# Only produces android_extensions.descriptor for the diff below; nothing uses
# its generated code, so it emits none (proto_generators = []).
perfetto_proto_library("android_extensions_@TYPE@") {
  proto_generators = []
  sources = [ "android_extensions.proto" ]
  public_deps = [
    "art:art_heap_graph_@TYPE@",
    "connectivity:connectivity_network_trace_@TYPE@",
    "frameworks/base/proto/tracing:frameworks_base_common_@TYPE@",
    "frameworks/base/proto/tracing:frameworks_base_interned_data_@TYPE@",
    "frameworks/base/proto/tracing:frameworks_base_trace_packet_@TYPE@",
    "frameworks/base/proto/tracing:frameworks_base_track_event_@TYPE@",
    "frameworks/native/tracing:frameworks_native_interned_data_@TYPE@",
    "frameworks/native/tracing:frameworks_native_trace_packet_@TYPE@",
    "frameworks/native/tracing:frameworks_native_track_event_@TYPE@",
    "frameworks/native/tracing/winscope:winscope_extensions_@TYPE@",
    "frameworks/native/tracing/winscope:winscope_regular_@TYPE@",
    "packages/modules/bluetooth/tracing:bluetooth_tracing_@TYPE@",
  ]
  generate_descriptor = "android_extensions.descriptor"
  descriptor_root_source = "android_extensions.proto"

  # Some of these protos use custom options, so the descriptor build needs the
  # well-known protobuf types on its import path.
  import_dirs = [ "${perfetto_protobuf_src_dir}" ]
}

protozero_descriptor_diff("extension_descriptor") {
  minuend_descriptor_target = ":android_extensions_descriptor"
  minuend_descriptor_name = "android_extensions.descriptor"
  subtrahend_descriptor_target = "../../perfetto/trace:descriptor"
  subtrahend_descriptor_name = "trace.descriptor"
  generate_descriptor = "android_extension.descriptor"
}
