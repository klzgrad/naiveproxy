  # Library target for the trace processor shell.
  # Allows embedders (e.g. Google3) to customize the shell executable's
  # interaction with the environment.
  static_library("trace_processor_shell_lib") {
    deps = [
      ":lib",
      ":local_file_system",
      "../../gn:default_deps",
      "../../gn:protobuf_full",
      "../../include/perfetto/ext/trace_processor:trace_processor_shell",
