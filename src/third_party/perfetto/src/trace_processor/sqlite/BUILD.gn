    "../../../gn:default_deps",
    "../../../gn:gtest_and_gmock",
    "../../../gn:sqlite",
    "../../../include/perfetto/ext/base",
    "../../../include/perfetto/trace_processor:basic_types",
    "../../../include/perfetto/trace_processor:io",
    "../../base",
    "../../base:test_support",
    "../containers",
    "../importers/common:stats_tracker",
    "../perfetto_sql/engine",
    "../storage",
  ]
}

if (enable_perfetto_benchmarks) {
  source_set("benchmarks") {
    testonly = true
    deps = [
      ":sqlite",
      "../../../gn:benchmark",
