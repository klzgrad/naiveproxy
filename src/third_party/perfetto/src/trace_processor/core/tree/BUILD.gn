import("../../../../gn/test.gni")

source_set("tree") {
  sources = [
    "tree.h",
    "tree_column_ops.cc",
    "tree_column_ops.h",
    "tree_from_dataframe.cc",
    "tree_from_dataframe.h",
    "tree_path_interner.cc",
    "tree_path_interner.h",
  ]
  deps = [
    "../../../../gn:default_deps",
    "../../../../include/perfetto/ext/base",
    "../../../../include/perfetto/trace_processor:basic_types",
    "../../../base",
    "../../containers",
    "../common",
    "../dataframe",
    "../util",
  ]
}

perfetto_unittest_source_set("unittests") {
  testonly = true
  sources = [
    "tree_algorithms_unittest.cc",
    "tree_column_ops_unittest.cc",
  ]
  deps = [
    ":tree",
    "../../../../gn:default_deps",
    "../../../../gn:gtest_and_gmock",
    "../../../../include/perfetto/ext/base",
    "../../containers",
    "../dataframe",
    "../util",
  ]
}

if (enable_perfetto_benchmarks) {
  source_set("benchmarks") {
    testonly = true
    sources = [ "tree_from_dataframe_benchmark.cc" ]
    deps = [
      ":tree",
      "../../../../gn:benchmark",
      "../../../../gn:default_deps",
      "../../../../include/perfetto/base",
      "../../containers",
      "../dataframe",
    ]
  }
}
